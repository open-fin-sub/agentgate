{
  "填写说明": {
    "必填": {
      "name": "样本名称，非空文本",
      "turns": "至少一轮，数组第一项为第 1 轮。单轮样本只填写第一项。",
      "turns[].input": "每轮的用户输入，非空 JSON 对象"
    },
    "可选": {
      "category": "正例 / 负例 / 边界，默认正例",
      "difficulty": "简单 / 中等 / 困难，默认中等",
      "initial_state": "初始变量，填写 JSON 对象，默认 {}",
      "tags": "标签数组，默认 []",
      "notes": "样本备注，默认空白",
      "turns[].expectations": "测评项数组，默认 []",
      "turns[].notes": "轮次备注，默认空白",
      "turns[].extensions": "轮次扩展，可省略"
    },
    "系统生成": "导入时生成样本、轮次和测评项 ID。轮次按数组中的顺序排列。"
  },
  "cases": [
    {
      "name": "单轮问答示例",
      "category": "正例",
      "difficulty": "中等",
      "turns": [
        {
          "input": {
            "txt": "你好"
          },
          "expectations": [
            {
              "kind": "output",
              "condition": {
                "kind": "equals",
                "expected": "你好，请问有什么可以帮您？"
              }
            }
          ]
        }
      ]
    }
  ]
}
